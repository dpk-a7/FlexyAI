# FastAPI authentication. Generate APP_SECRET_KEY with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=<random-secret-of-at-least-32-bytes>
TOKEN_EXPIRATION=30m
SUPERUSER_USERNAME=admin
SUPERUSER_PASSWORD=<set-a-strong-bootstrap-password>

# Windows-native Docker infrastructure. Generate REDIS_PASSWORD with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=<random-redis-password>
REDIS_PORT=6379
FLEXY_HTTP_PORT=8080
# Set REDIS_URL only when using a non-local Redis server. Otherwise the native
# API derives its authenticated loopback URL from REDIS_PASSWORD and REDIS_PORT.
# REDIS_URL=redis://:<password>@127.0.0.1:6379/0

# Native video worker configuration.
MODEL_PATH=D:/ComfyModels/models
ARTIFACT_ROOT=D:/FlexyAI/artifacts
AUTO_DELETE_MEDIA=30m
DOWNLOAD_URL_TTL=10m
MAX_UPLOAD_BYTES=1073741824

# Host/GPU protection thresholds. Defaults match these values when omitted.
RAM_WARNING_PERCENT=80
RAM_CRITICAL_PERCENT=90
RAM_HARD_STOP_PERCENT=95
RAM_RECOVERY_PERCENT=85
SWAP_WARNING_PERCENT=25
SWAP_CRITICAL_PERCENT=50
SWAP_HARD_STOP_PERCENT=90
SWAP_RECOVERY_PERCENT=20
OFFLOAD_MIN_AVAILABLE_PERCENT=10
OFFLOAD_HARD_STOP_AVAILABLE_PERCENT=5
OFFLOAD_MIN_AVAILABLE_GB=8
OFFLOAD_HARD_STOP_AVAILABLE_GB=4
OFFLOAD_RECOVERY_AVAILABLE_PERCENT=15
OFFLOAD_RECOVERY_AVAILABLE_GB=8
GPU_TEMP_WARNING=80
GPU_TEMP_CRITICAL=85
GPU_TEMP_HARD_STOP=90
GPU_TEMP_RECOVERY=80
GPU_TEMP_HARD_STOP_DURATION_SECONDS=10
RESOURCE_POLL_SECONDS=1

# Required only when starting the optional Ngrok tunnel profile.
NGROK_AUTHTOKEN=
